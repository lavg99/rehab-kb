rules_version = '2';
// คลังความรู้ฟื้นฟูฯ — เก็บแค่ตัวนับการอ่าน + คะแนนความเข้าใจ (ไม่มีข้อมูลส่วนตัว)
// ทุกคนเพิ่มได้ตามรูปแบบที่กำหนดเท่านั้น · อ่านได้ (หน้าสถิติ) · แก้/ลบไม่ได้
service cloud.firestore {
  match /databases/{db}/documents {
    function okSlug(a) { return a is string && a.matches('^[a-z0-9-]{1,60}$'); }
    function okDay(d)  { return d is string && d.matches('^20[2-9][0-9]-[01][0-9]-[0-3][0-9]$'); }

    match /views/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['a', 'd', 'src'])
        && okSlug(request.resource.data.a) && okDay(request.resource.data.d)
        && request.resource.data.src in ['qr', 'web'];
      allow update, delete: if false;
    }
    match /feedback/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['a', 'd', 's'])
        && okSlug(request.resource.data.a) && okDay(request.resource.data.d)
        && request.resource.data.s is int && request.resource.data.s >= 1 && request.resource.data.s <= 5;
      allow update, delete: if false;
    }
    // แบบประเมินความพึงพอใจ: บทบาท + คะแนน 1-5 จำนวน 7 ข้อ + ข้อเสนอแนะไม่เกิน 300 ตัวอักษร
    function okScore(v) { return v is int && v >= 1 && v <= 5; }
    match /survey/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['d', 'r', 'q1', 'q2', 'q3', 'q4', 'q5', 'pre', 'post', 'c'])
        && request.resource.data.keys().hasAll(['d', 'r', 'q1', 'q2', 'q3', 'q4', 'q5', 'pre', 'post'])
        && okDay(request.resource.data.d)
        && request.resource.data.r in ['patient', 'family', 'staff', 'other']
        && okScore(request.resource.data.q1) && okScore(request.resource.data.q2) && okScore(request.resource.data.q3)
        && okScore(request.resource.data.q4) && okScore(request.resource.data.q5)
        && okScore(request.resource.data.pre) && okScore(request.resource.data.post)
        && (!('c' in request.resource.data) || (request.resource.data.c is string && request.resource.data.c.size() <= 300));
      allow update, delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
